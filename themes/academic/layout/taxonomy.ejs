<header class="page-heading"><p class="eyebrow"><%= page.taxonomy === 'tags' ? 'TAGS' : 'CATEGORIES' %></p><h1><%= page.title %></h1><p>从一个主题开始阅读。</p></header>
<%- partial('_partials/blog-nav') %>
<div class="taxonomy-list"><% const entries = page.taxonomy === 'tags' ? site.tags : site.categories; entries.sort('name').each(item => { %><a href="<%= url_for(item.path) %>"><span><%= item.name %></span><span class="muted"><%= item.length %> 篇 <span aria-hidden="true">↗</span></span></a><% }); %></div>
