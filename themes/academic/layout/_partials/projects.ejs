<div class="projects-list"><% projects.forEach(project => { %><article class="project-entry"><% if (project.image) { %><img src="<%= url_for(project.image) %>" alt="<%= project.title %> 项目预览" loading="lazy" width="240" height="150"><% } else { %><div class="project-placeholder" aria-hidden="true">&lt;/&gt;</div><% } %><div><h2><% if (project.url) { %><a href="<%= project.url %>" target="_blank" rel="noopener noreferrer"><%= project.title %></a><% } else { %><%= project.title %><% } %></h2><div class="project-tags"><% (project.tags || []).forEach(tag => { %><span><%= tag %></span><% }); %></div><p><%= project.description %></p><div class="paper-links"><% if (project.code) { %><a href="<%= project.code %>" target="_blank" rel="noopener noreferrer">GitHub ↗</a><% } %><% if (project.paper) { %><a href="<%= project.paper %>" target="_blank" rel="noopener noreferrer">论文 ↗</a><% } %><% if (project.url) { %><a href="<%= project.url %>" target="_blank" rel="noopener noreferrer">查看项目 ↗</a><% } %></div></div></article><% }); %></div>
