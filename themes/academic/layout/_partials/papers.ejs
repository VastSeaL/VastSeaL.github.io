<div class="papers-list"><% papers.forEach(paper => { %><article class="paper-entry"><div class="paper-year"><%= paper.year || '' %></div><div><h2><% if (paper.url) { %><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer"><%= paper.title %></a><% } else { %><%= paper.title %><% } %></h2><p class="paper-authors"><%= paper.authors %></p><p class="paper-venue"><%= paper.venue %><% if (paper.status) { %> · <%= paper.status %><% } %></p><div class="paper-links"><% if (paper.url) { %><a href="<%= paper.url %>" target="_blank" rel="noopener noreferrer">论文 ↗</a><% } %><% if (paper.code) { %><a href="<%= paper.code %>" target="_blank" rel="noopener noreferrer">代码 ↗</a><% } %></div><% if (paper.abstract) { %><details class="paper-details"><summary>摘要</summary><p><%= paper.abstract %></p></details><% } %><% if (paper.bibtex) { %><details class="paper-details"><summary>引用 / BibTeX</summary><pre><code><%= paper.bibtex %></code></pre></details><% } %></div></article><% }); %></div>
