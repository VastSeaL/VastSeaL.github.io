<article class="post-row">
  <time class="post-date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
  <div class="post-row-body"><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= plain_summary(post, compact ? 90 : 150) %></p><div class="post-row-meta"><% post_taxonomy(post).forEach(tag => { %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }); %><span><%= reading_minutes(post) %> 分钟阅读</span></div></div>
  <a class="row-arrow" href="<%= url_for(post.path) %>" aria-label="阅读：<%= post.title %>">↗</a>
</article>
