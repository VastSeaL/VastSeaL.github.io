<header class="page-heading"><p class="eyebrow">THE NOTEBOOK</p><h1>博客笔记<span class="heading-count"><%= site.posts.length %></span></h1><p>把学习中的问题、方法和实践，整理成可以再次查阅的笔记。</p></header>
<%- partial('_partials/blog-nav') %>
<div class="post-list"><% page.posts.each(post => { %><%- partial('_partials/post-row', { post, compact: false }) %><% }); %></div>
<% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({ prev_text: '← 上一页', next_text: '下一页 →' }) %></nav><% } %>
